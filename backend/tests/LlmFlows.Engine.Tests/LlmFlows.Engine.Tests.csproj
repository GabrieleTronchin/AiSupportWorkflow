<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Test helpers wait on short in-memory operations; passing the test token everywhere adds noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="FsCheck.Xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\LlmFlows.Definitions\LlmFlows.Definitions.csproj" />
    <ProjectReference Include="..\..\src\Engine\LlmFlows.Persistence\LlmFlows.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Engine\LlmFlows.Runtime\LlmFlows.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Services\LlmFlows.Engine.Service\LlmFlows.Engine.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
