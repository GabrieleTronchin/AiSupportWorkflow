{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmflows.local/schemas/workflow.schema.json",
  "title": "LlmFlows workflow definition",
  "description": "A workflow: input schema, steps and transitions. Strings containing {{ }} are Scriban templates; 'when' conditions are Scriban expressions.",
  "type": "object",
  "required": ["id", "version", "name", "input", "start", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/workflowId" },
    "version": { "type": "integer", "minimum": 1, "description": "Bump when the workflow changes." },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "title": { "type": "string", "description": "Template for the run title shown in listings, e.g. \"{{ input.subject }}\"." },
    "input": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": { "$ref": "#/$defs/schemaSource" },
        "errorMessage": { "type": "string", "description": "Message returned with 400 when the input does not match the schema." }
      }
    },
    "start": { "$ref": "#/$defs/stepId" },
    "maxSteps": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "Maximum number of steps executed by one run (default 100)." },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "workflowId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "stepId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "snake_case, usable in expressions as steps.<id>." },
    "toolName": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-zA-Z][a-zA-Z0-9]*$", "description": "<moduleId>.<name>" },
    "template": { "type": "string" },
    "expression": { "type": "string", "minLength": 1 },
    "fileRef": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": { "file": { "type": "string", "minLength": 1, "description": "Path relative to the module definition folder." } }
    },
    "textSource": {
      "description": "Inline text (template) or a file reference.",
      "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/fileRef" }]
    },
    "schemaSource": {
      "description": "Inline JSON Schema (draft 2020-12) or { file: path }.",
      "type": "object"
    },
    "schemaRef": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": { "schema": { "$ref": "#/$defs/schemaSource" } }
    },
    "transition": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": {
        "when": { "$ref": "#/$defs/expression" },
        "to": { "$ref": "#/$defs/stepId" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["output"],
      "additionalProperties": false,
      "properties": {
        "match": { "type": "string", "minLength": 1, "description": "Regular expression matched against the value." },
        "when": { "$ref": "#/$defs/expression" },
        "output": { "description": "Output when the rule matches (templates allowed)." }
      },
      "oneOf": [{ "required": ["match"] }, { "required": ["when"] }]
    },
    "failure": {
      "type": "object",
      "required": ["fail"],
      "additionalProperties": false,
      "properties": { "fail": { "type": "string", "minLength": 1 } }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "description": "Response used in Demo mode: a static output, ordered rules with a default, or a tool.",
      "properties": {
        "output": {},
        "value": { "$ref": "#/$defs/template" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
        "default": {},
        "tool": { "$ref": "#/$defs/toolName" }
      },
      "oneOf": [
        { "required": ["output"] },
        { "required": ["rules", "default"] },
        { "required": ["tool"] }
      ]
    },
    "mapOutput": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "value": {},
        "lookup": { "type": "string", "minLength": 1 },
        "key": { "$ref": "#/$defs/template" },
        "onMissing": { "type": "string", "description": "Failure message when the key is not in the lookup (default: generic message)." }
      },
      "oneOf": [{ "required": ["value"] }, { "required": ["lookup", "key"] }]
    },
    "step": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "kind": { "enum": ["llm", "rule", "map", "human-input", "tool", "http", "terminal"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "detail": { "$ref": "#/$defs/template", "description": "Detail of the step-completed event and of the run." },
        "assignAgent": { "$ref": "#/$defs/template", "description": "Sets the run's assigned agent after the step (must be a declared agent)." },
        "next": { "$ref": "#/$defs/stepId" },
        "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "llm" } } }, "then": { "$ref": "#/$defs/llmStep" } },
        { "if": { "properties": { "kind": { "const": "rule" } } }, "then": { "$ref": "#/$defs/ruleStep" } },
        { "if": { "properties": { "kind": { "const": "map" } } }, "then": { "$ref": "#/$defs/mapStep" } },
        { "if": { "properties": { "kind": { "const": "human-input" } } }, "then": { "$ref": "#/$defs/humanInputStep" } },
        { "if": { "properties": { "kind": { "const": "tool" } } }, "then": { "$ref": "#/$defs/toolStep" } },
        { "if": { "properties": { "kind": { "const": "http" } } }, "then": { "$ref": "#/$defs/httpStep" } },
        { "if": { "properties": { "kind": { "const": "terminal" } } }, "then": { "$ref": "#/$defs/terminalStep" } }
      ],
      "unevaluatedProperties": false
    },
    "llmStep": {
      "required": ["prompt", "output"],
      "properties": {
        "systemPrompt": { "$ref": "#/$defs/textSource" },
        "prompt": { "$ref": "#/$defs/textSource" },
        "output": { "$ref": "#/$defs/schemaRef" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "agent": { "$ref": "#/$defs/template", "description": "Agent the call is attributed to (default: the run's assigned agent)." },
        "demo": { "$ref": "#/$defs/demo" }
      }
    },
    "ruleStep": {
      "required": ["value", "rules"],
      "properties": {
        "value": { "$ref": "#/$defs/template" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
        "ignoreCase": { "type": "boolean", "default": true },
        "onMultipleMatches": { "oneOf": [{ "const": "first" }, { "$ref": "#/$defs/failure" }] },
        "onNoMatch": {
          "oneOf": [
            { "$ref": "#/$defs/failure" },
            { "type": "object", "required": ["output"], "additionalProperties": false, "properties": { "output": {} } }
          ]
        }
      }
    },
    "mapStep": {
      "required": ["outputs"],
      "properties": {
        "lookups": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapOutput" } }
      }
    },
    "humanInputStep": {
      "required": ["review"],
      "properties": {
        "review": {
          "type": "object",
          "required": ["title", "fields"],
          "additionalProperties": false,
          "properties": {
            "title": { "$ref": "#/$defs/template" },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "value"],
                "additionalProperties": false,
                "properties": { "label": { "type": "string" }, "value": { "$ref": "#/$defs/template" } }
              }
            }
          }
        }
      }
    },
    "toolStep": {
      "required": ["tool"],
      "properties": {
        "tool": { "$ref": "#/$defs/toolName" },
        "input": { "type": "object" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "httpStep": {
      "required": ["method", "url"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "url": { "$ref": "#/$defs/template" },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "required": ["secret"], "additionalProperties": false, "properties": { "secret": { "type": "string", "minLength": 1 } } }
            ]
          }
        },
        "body": {},
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "output": { "$ref": "#/$defs/schemaRef" }
      }
    },
    "terminalStep": {
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["success", "failure"] },
        "message": { "$ref": "#/$defs/template" },
        "output": {}
      }
    }
  }
}
