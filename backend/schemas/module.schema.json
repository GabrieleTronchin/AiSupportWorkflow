{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmflows.local/schemas/module.schema.json",
  "title": "LlmFlows module manifest",
  "description": "module.yaml: module id, configuration, agents, tools, workflow and sample files.",
  "type": "object",
  "required": ["id", "name", "workflows"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "config": { "type": "object", "description": "Free-form values exposed to templates as config.*. Never put secrets here." },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^\\S+$" },
          "name": { "type": "string", "minLength": 1 },
          "group": { "type": "string" },
          "role": { "type": "string" },
          "persona": { "type": "string" }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-zA-Z][a-zA-Z0-9]*$" },
          "description": { "type": "string" },
          "input": { "$ref": "#/$defs/schemaRef" },
          "output": { "$ref": "#/$defs/schemaRef" },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
        }
      }
    },
    "workflows": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "samples": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "schemaRef": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": { "schema": { "type": "object", "description": "Inline JSON Schema or { file: path }." } }
    }
  }
}
