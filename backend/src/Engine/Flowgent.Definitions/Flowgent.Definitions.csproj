<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Flowgent definition model: YAML loading, validation, Scriban expressions and JSON Schema helpers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowgent.Contracts\Flowgent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\schemas\*.schema.json" LogicalName="Flowgent.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowgent.Engine.Tests" />
  </ItemGroup>

</Project>
