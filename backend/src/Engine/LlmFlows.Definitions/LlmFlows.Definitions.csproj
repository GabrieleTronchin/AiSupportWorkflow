<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>LlmFlows definition model: YAML loading, validation, Scriban expressions and JSON Schema helpers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LlmFlows.Contracts\LlmFlows.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\schemas\*.schema.json" LogicalName="LlmFlows.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LlmFlows.Engine.Tests" />
  </ItemGroup>

</Project>
