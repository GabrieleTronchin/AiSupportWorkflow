<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════════
       Transitive Pinning (vulnerability fixes)
       ═══════════════════════════════════════════════════════════════════ -->
  <ItemGroup Label="Transitive Overrides">
    <PackageVersion Include="OpenTelemetry.Api" Version="1.20.1" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════
       Microsoft Agents AI
       ═══════════════════════════════════════════════════════════════════ -->
  <ItemGroup Label="Microsoft.Agents">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.27.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.27.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.27.0" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════
       gRPC
       ═══════════════════════════════════════════════════════════════════ -->
  <ItemGroup Label="gRPC">
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="Grpc.AspNetCore.Web" Version="2.85.0" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════
       Microsoft Extensions
       ═══════════════════════════════════════════════════════════════════ -->
  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════
       Testing
       ═══════════════════════════════════════════════════════════════════ -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
